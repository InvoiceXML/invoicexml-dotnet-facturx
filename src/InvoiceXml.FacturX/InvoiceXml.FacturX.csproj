<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>InvoiceXml.FacturX</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <!-- These rules suggest APIs that exist on .NET 8 only; the code also targets netstandard2.0. -->
    <NoWarn>$(NoWarn);CA1510;CA1835;CA1865;CA2263</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>InvoiceXml.FacturX</PackageId>
    <Version>1.0.0</Version>
    <Title>Factur-X for .NET (InvoiceXML API client)</Title>
    <Authors>InvoiceXML</Authors>
    <Company>InvoiceXML</Company>
    <Copyright>Copyright (c) 2026 InvoiceXML</Copyright>
    <Description>Create, validate, embed and read Factur-X e-invoices from C# and .NET. A thin, typed client for the InvoiceXML REST API: EN 16931 invoice model in, Factur-X PDF/A-3 out, validated against the official rule sets before delivery, with the French BR-FR rules on request. Rule sets are updated on their legal effective dates, with no package update needed.</Description>
    <PackageTags>facturx;factur-x;facture-electronique;e-invoicing;einvoicing;e-invoice;en16931;chorus-pro;cii;pdf-a-3;invoice;france;b2b;b2g;br-fr</PackageTags>
    <PackageProjectUrl>https://www.invoicexml.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/InvoiceXML/invoicexml-dotnet-facturx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InvoiceXml.FacturX.Tests" />
  </ItemGroup>

</Project>
